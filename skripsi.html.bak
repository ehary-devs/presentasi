</section>

<!-- 13 ITERASI -->
<section class="slide" style="--tint:var(--clay)">
  <div class="spine"><span>BAB IV · Hasil</span></div>
  <h2>Hasil iterasi algoritma Apriori</h2>
  <p class="sub">Parameter terpilih: minimum support 0,50% · minimum confidence 30% · minimum lift 1,20 · 7.100 transaksi.</p>
  <div class="hr"></div>
  <div class="body">
    <div class="tablewrap">
      <table>
        <thead>
          <tr><th>Tahap</th><th class="n">Kandidat</th><th class="n">Lolos</th><th class="n">Rasio</th><th class="n">Waktu</th><th>Keterangan</th></tr>
        </thead>
        <tbody>
          <tr><td>Iterasi 1 — 1-itemset</td><td class="n">2.021</td><td class="n">482</td><td class="n">23,85%</td><td class="n">&lt; 1 dtk</td><td>ISBN dengan support ≥ 0,50%</td></tr>
          <tr><td>Iterasi 2 — 2-itemset</td><td class="n">115.921</td><td class="n">30</td><td class="n">0,03%</td><td class="n">± 4 dtk</td><td>Penyusutan drastis akibat data sparsity</td></tr>
          <tr><td>Pembentukan aturan</td><td class="n">60</td><td class="n">50</td><td class="n">83,33%</td><td class="n">&lt; 1 dtk</td><td>10 aturan gugur karena confidence &lt; 30%</td></tr>
        </tbody>
